{
  "name": "my-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:tailwind && ng serve",
    "build": "npm run build:tailwind && ng build",
    "deploy": "npm run build:tailwind && ng build --base-href /my-portfolio/ && npx angular-cli-ghpages --dir=dist/my-portfolio/browser",
    "build:tailwind": "tailwindcss -i src/styles.css -o src/tailwind-build.css",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:my-portfolio": "node dist/my-portfolio/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.5.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@angular/ssr": "^21.2.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^3.0.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2"
  }
}
